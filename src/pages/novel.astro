---
import { Icon } from "astro-icon/components";
import { PageHeader } from "@components/features/page-header";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

// 小说书单：站长推荐的火书
// 每本书 = 封面图 + 一段介绍 + 跳转链接（免费阅读 + 支持正版）
const bookShelf = [
	{
		title: "龙族",
		author: "江南",
		recommended: true,
		cover: baseUrl + "/assets/covers/novel-dragon-raja.jpg",
		desc: "一封来自卡塞尔学院的录取通知书，把普通高中生路明非拉进了一个龙与混血种的隐秘世界。「东方《哈利·波特》」级别的青春幻想神作，绘梨衣、楚子航、夏弥……每个角色都让人记一辈子。站长最爱的网文，没有之一 (๑•̀ㅂ•́)و✧",
		freeUrl: "https://m.qidian.com/bookrecommend/sqbcf9a15545a348dc",
		freeLabel: "在线免费阅读（起点官方）",
		supportUrl: "https://weread.qq.com/web/reader/2be32e205e3dd02be3a12bck33e3289021c33e75ff09694",
		supportLabel: "支持正版（微信读书）",
	},
	{
		title: "斗破苍穹",
		author: "天蚕土豆",
		recommended: false,
		cover: baseUrl + "/assets/covers/novel-battle-break.jpg",
		desc: "「三十年河东，三十年河西，莫欺少年穷！」废柴萧炎从乌坦城一路逆袭成斗帝。斗气大陆的等级制度、异火榜、炼药师……当年的班里传阅神书，起点百亿点击的玄幻经典。",
		freeUrl: "https://read.qidian.com/chapter/2R9G_ziBVg41/MyEcwtk5i8Iex0RJOkJclQ2/",
		freeLabel: "起点免费试读",
		supportUrl: "https://m.qidian.com/book/1048736491/?_trace=doubao",
		supportLabel: "支持正版（起点中文网）",
	},
	{
		title: "斗罗大陆",
		author: "唐家三少",
		recommended: false,
		cover: baseUrl + "/assets/covers/novel-memories.jpg",
		desc: "双生武魂的唐三从唐门外门弟子，一步步成为魂师界的传说。魂环、魂技、武魂真身……小学时代班里传得最凶的玄幻，是多少人看的第一本「长篇连载」。",
		freeUrl: "https://www.qidian.com/",
		freeLabel: "起点中文网",
		supportUrl: "https://www.qidian.com/",
		supportLabel: "支持正版（起点中文网）",
	},
];
---

<MainGridLayout title="小说" description="站长推荐的小说书单">

	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-6 sm:px-9 py-6 relative w-full">
			<PageHeader
				title="小说书单"
				subtitle="站长看过的、推荐的书，点卡片就能读 (๑•̀ㅂ•́)و✧"
			/>

			<!-- 提示横幅 -->
			<div
				class="mb-8 rounded-xl border border-amber-500/30 bg-amber-500/5 p-4 flex items-start gap-3"
			>
				<Icon name="material-symbols:info-rounded" class="text-2xl text-amber-500 shrink-0 mt-0.5" />
				<p class="text-sm text-black/60 dark:text-white/60 leading-relaxed">
					这里的书籍整理自公开网络，仅供个人阅读交流 (｡•̀ᴗ-)✧
					如果喜欢一部作品，欢迎去正版平台支持作者，网文作者不容易。
				</p>
			</div>

			<!-- 书单卡片 -->
			<div class="space-y-6">
				{
					bookShelf.map((book) => (
						<div
							class="group flex flex-col sm:flex-row gap-5 p-5 rounded-2xl border border-(--line-divider) hover:border-(--primary) hover:bg-(--card-bg) transition-all duration-300 hover:shadow-lg relative overflow-hidden"
						>
							<div class="absolute inset-0 bg-(--primary) opacity-0 group-hover:opacity-5 transition-opacity duration-300 pointer-events-none" />

							{/* 封面 */}
							<div class="shrink-0 w-full sm:w-40 h-56 sm:h-48 rounded-xl overflow-hidden border border-black/5 dark:border-white/5 bg-zinc-100 dark:bg-zinc-800">
								<img
									src={book.cover}
									alt={book.title}
									loading="lazy"
									decoding="async"
									class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
								/>
							</div>

							{/* 内容 */}
							<div class="grow min-w-0 flex flex-col">
								<div class="flex items-center gap-2 mb-1 flex-wrap">
									<h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">
										{book.title}
									</h2>
									<span class="text-sm text-neutral-500 dark:text-neutral-400">
										{book.author}
									</span>
									{book.recommended && (
										<span class="shrink-0 text-[11px] px-2 py-0.5 rounded-full bg-(--primary)/10 text-(--primary) font-medium">
											站长推荐 ★
										</span>
									)}
								</div>
								<p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed mb-4 line-clamp-4">
									{book.desc}
								</p>

								<div class="mt-auto flex flex-wrap gap-2">
									<a
										href={book.freeUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-(--primary) text-white text-sm font-medium hover:opacity-90 transition-opacity"
									>
										<Icon name="material-symbols:menu-book-rounded" class="text-base" />
										{book.freeLabel}
									</a>
									<a
										href={book.supportUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border border-(--line-divider) text-sm font-medium hover:border-(--primary) hover:text-(--primary) transition-all duration-200"
									>
										<Icon name="material-symbols:favorite-rounded" class="text-base" />
										{book.supportLabel}
									</a>
								</div>
							</div>
						</div>
					))
				}
			</div>

			<!-- 计划中的栏目 -->
			<section class="mt-10">
				<div class="flex items-center gap-2 mb-3 pb-2 border-b border-(--line-divider)">
					<Icon name="material-symbols:menu-book-rounded" class="text-(--primary) text-xl shrink-0" />
					<h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-100">
						计划中的栏目
					</h2>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
					<div class="p-4 rounded-xl border border-(--line-divider) bg-(--card-bg)">
						<Icon name="material-symbols:recommend-rounded" class="text-2xl text-(--primary) mb-2" />
						<p class="font-bold text-sm mb-1">小说推荐</p>
						<p class="text-xs text-neutral-500 dark:text-neutral-400">
							书单持续扩充中，每本附一句入坑理由
						</p>
					</div>
					<div class="p-4 rounded-xl border border-(--line-divider) bg-(--card-bg)">
						<Icon name="material-symbols:edit-note-rounded" class="text-2xl text-(--primary) mb-2" />
						<p class="font-bold text-sm mb-1">读书笔记</p>
						<p class="text-xs text-neutral-500 dark:text-neutral-400">
							读完一本记一点，攒成自己的阅读时间线
						</p>
					</div>
					<div class="p-4 rounded-xl border border-(--line-divider) bg-(--card-bg)">
						<Icon name="material-symbols:forum-rounded" class="text-2xl text-(--primary) mb-2" />
						<p class="font-bold text-sm mb-1">书友闲聊</p>
						<p class="text-xs text-neutral-500 dark:text-neutral-400">
							书荒互助、求书推荐，都在留言板见
						</p>
					</div>
				</div>
			</section>

			<!-- 声明 -->
			<p class="mt-8 text-center text-[11px] text-black/30 dark:text-white/30">
				书单收录自公开网络，侵删致歉；有想安利给站长的书，去留言板说一声 (人´∀｀)
			</p>
		</div>
	</div>

	<style>
		.line-clamp-4 {
			display: -webkit-box;
			-webkit-line-clamp: 4;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
	</style>
</MainGridLayout>
