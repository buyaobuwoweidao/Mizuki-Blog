---
import { Icon } from "astro-icon/components";
import { PageHeader } from "@components/features/page-header";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";

// 拉取小说分类的文章
const novelPosts = (await getCollection("posts"))
	.filter((post) => post.data.category === "小说" && !post.data.draft)
	.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<MainGridLayout title="小说" description="小说推荐与读书笔记">

	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-6 sm:px-9 py-6 relative w-full">
			<PageHeader
				title="小说"
				subtitle="网络小说、轻小说、读书笔记 (´▽`)ﾉ"
			/>

			<!-- 文章列表 -->
			{
				novelPosts.length > 0 && (
					<section class="mb-8">
						<div class="flex items-center gap-2 mb-3 pb-2 border-b border-(--line-divider)">
							<Icon name="material-symbols:auto-stories-rounded" class="text-(--primary) text-xl shrink-0" />
							<h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-100">
								小说文章
							</h2>
							<span class="text-xs text-neutral-500 dark:text-neutral-400">
								已收录 {novelPosts.length} 篇
							</span>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
							{
								novelPosts.map((post) => (
									<a
										href={"/Mizuki-Blog/posts/" + post.slug + "/"}
										class="group flex items-center gap-3 p-3 rounded-xl border border-(--line-divider) hover:border-(--primary) hover:bg-(--card-bg) transition-all duration-300 hover:shadow-lg relative overflow-hidden"
									>
										<div class="absolute inset-0 bg-(--primary) opacity-0 group-hover:opacity-5 transition-opacity duration-300 pointer-events-none" />
										<div class="w-11 h-11 shrink-0 rounded-xl bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5 flex items-center justify-center">
											<Icon name="material-symbols:menu-book-rounded" class="text-xl text-(--primary) group-hover:scale-110 transition-transform duration-300" />
										</div>
										<div class="grow min-w-0 flex flex-col justify-center">
											<div class="font-bold text-sm text-neutral-900 dark:text-neutral-100 group-hover:text-(--primary) transition-colors line-clamp-2">
												{post.data.title}
											</div>
											<div class="text-xs text-neutral-500 dark:text-neutral-400 truncate mt-0.5">
												{post.data.description}
											</div>
										</div>
										<Icon
											name="material-symbols:arrow-outward-rounded"
											class="shrink-0 text-(--primary) text-lg opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300"
										/>
									</a>
								))
							}
						</div>
					</section>
				)
			}

			<!-- 计划中的栏目 -->
			<section>
				<div class="flex items-center gap-2 mb-3 pb-2 border-b border-(--line-divider)">
					<Icon name="material-symbols:menu-book-rounded" class="text-(--primary) text-xl shrink-0" />
					<h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-100">
						计划中的栏目
					</h2>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
					<div class="p-4 rounded-xl border border-(--line-divider) bg-(--card-bg)">
						<Icon name="material-symbols:recommend-rounded" class="text-2xl text-(--primary) mb-2" />
						<p class="font-bold text-sm mb-1">小说推荐</p>
						<p class="text-xs text-neutral-500 dark:text-neutral-400">
							看过的网络小说、轻小说安利，附一句入坑理由
						</p>
					</div>
					<div class="p-4 rounded-xl border border-(--line-divider) bg-(--card-bg)">
						<Icon name="material-symbols:edit-note-rounded" class="text-2xl text-(--primary) mb-2" />
						<p class="font-bold text-sm mb-1">读书笔记</p>
						<p class="text-xs text-neutral-500 dark:text-neutral-400">
							读完一本记一点，攒成自己的阅读时间线
						</p>
					</div>
					<div class="p-4 rounded-xl border border-(--line-divider) bg-(--card-bg)">
						<Icon name="material-symbols:forum-rounded" class="text-2xl text-(--primary) mb-2" />
						<p class="font-bold text-sm mb-1">书友闲聊</p>
						<p class="text-xs text-neutral-500 dark:text-neutral-400">
							书荒互助、求书推荐，都在留言板见
						</p>
					</div>
				</div>
			</section>

			<!-- 来源说明 -->
			<p class="mt-8 text-center text-[11px] text-black/30 dark:text-white/30">
				栏目持续更新中，有想安利给站长的书，去留言板说一声 (´･ω･`)
			</p>
		</div>
	</div>

	<style>
		.line-clamp-2 {
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
	</style>
</MainGridLayout>
