---
import { Icon } from "astro-icon/components";
import { PageHeader } from "@components/features/page-header";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "@utils/content-utils";
import { siteConfig } from "../config";
import { url } from "../utils/url-utils";

// 视觉小说封面式首页：大背景图 + 中央标题 + 底部导航按钮
const coverBtns = [
	{ name: "HOME", label: "首页", url: "/" },
	{ name: "BLOG", label: "文章", url: "/posts/" },
	{ name: "GAME", label: "游戏", url: "/games/" },
	{ name: "MC", label: "MC 专区", url: "/mc/" },
	{ name: "ME", label: "关于我", url: "/about/" },
];

// 最新文章（纯文字，不放封面图，保证首页轻量）
const recentPosts = (await getSortedPostsList()).slice(0, 5);

const fmtDate = (d: Date) => {
	const y = d.getFullYear();
	const m = String(d.getMonth() + 1).padStart(2, "0");
	const day = String(d.getDate()).padStart(2, "0");
	return `${y}-${m}-${day}`;
};
---

<MainGridLayout title="挚爱流萤" description="我的二次元小窝">

	<!-- 视觉小说封面块 -->
	<div
		class="relative w-full overflow-hidden rounded-(--radius-large) flex items-center justify-center min-h-[72vh]"
	>
		<img
			src={url("/images/albums/yuimi-lab/cover.webp")}
			alt=""
			class="absolute inset-0 w-full h-full object-cover object-center"
			loading="eager"
			decoding="async"
		/>
		<!-- 上下渐隐遮罩，保证文字可读 -->
		<div
			class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/30 to-black/70"
		></div>

		<div
			class="relative z-10 text-center px-6 py-16 flex flex-col items-center max-w-full"
		>
			<p
				class="text-xs sm:text-sm tracking-[0.35em] text-white/70 mb-5 select-none"
			>
				𝓕𝓲𝓻𝓮𝓯𝓵𝔂 · MIZUKI BLOG
			</p>
			<h1
				class="text-5xl sm:text-7xl font-black text-white drop-shadow-[0_4px_20px_rgba(0,0,0,0.6)] leading-tight"
			>
				挚爱流萤
			</h1>
			<p class="mt-4 text-white/90 text-base sm:text-lg drop-shadow">
				欢迎来到我的二次元小窝 (๑•̀ㅂ•́)و✧
			</p>

			<!-- 导航按钮组 -->
			<div class="mt-10 flex flex-wrap justify-center gap-3">
				{
					coverBtns.map((btn) => (
						<a
							href={url(btn.url)}
							class="group flex items-center gap-2 px-5 py-2.5 rounded-lg bg-white/10 backdrop-blur-sm border border-white/25 text-white text-sm font-bold hover:bg-(--primary) hover:border-(--primary) transition-all duration-300 active:scale-95"
						>
							<span class="text-white/60 group-hover:text-white/80 text-[0.65rem] tracking-widest">
								{btn.name}
							</span>
							<span>{btn.label}</span>
						</a>
					))
				}
			</div>
		</div>

		<!-- 左下角小字：站点运行信息 -->
		<div class="absolute bottom-4 left-5 z-10 text-left text-white/60 text-xs select-none">
			<p id="home-date">…</p>
			<p>站点已运行 <span id="home-days">…</span> 天</p>
		</div>
	</div>

	<!-- 最新文章 -->
	<section class="mt-8">
		<div class="flex items-center gap-2 mb-3 pb-2 border-b border-(--line-divider)">
			<Icon name="material-symbols:auto-stories-rounded" class="text-(--primary) text-xl shrink-0" />
			<div class="flex items-baseline gap-2 min-w-0">
				<h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-100 shrink-0">
					最新文章
				</h2>
				<span class="text-xs text-neutral-500 dark:text-neutral-400 truncate">
					最近写下的碎碎念 (｡•̀ᴗ-)✧
				</span>
			</div>
		</div>

		<div class="rounded-xl border border-(--line-divider) divide-y divide-(--line-divider)">
			{
				recentPosts.map((post) => (
					<a
						href={post.url}
						class="group flex items-center gap-3 px-4 py-3 hover:bg-(--card-bg) transition-colors duration-200"
					>
						<span class="shrink-0 text-xs text-neutral-500 dark:text-neutral-400 tabular-nums">
							{fmtDate(post.data.published)}
						</span>
						<span class="grow min-w-0 font-medium text-sm text-neutral-900 dark:text-neutral-100 group-hover:text-(--primary) transition-colors truncate">
							{post.data.title}
						</span>
						<Icon
							name="material-symbols:arrow-outward-rounded"
							class="shrink-0 text-(--primary) text-lg opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300"
						/>
					</a>
				))
			}
		</div>

		<div class="mt-4 text-center">
			<a
				href={url("/posts/")}
				class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-(--primary) text-white text-sm font-medium hover:opacity-90 transition-opacity"
			>
				查看全部文章
				<Icon name="material-symbols:arrow-outward-rounded" class="text-base" />
			</a>
		</div>
	</section>

	<script define:vars={{ siteStartDate: siteConfig.siteStartDate }}>
		// 显示当前日期与站点运行天数（轻量，无依赖）
		const dateEl = document.getElementById("home-date");
		const daysEl = document.getElementById("home-days");
		if (dateEl) {
			const now = new Date();
			const week = ["日", "一", "二", "三", "四", "五", "六"][now.getDay()];
			dateEl.textContent = `${now.getFullYear()} 年 ${now.getMonth() + 1} 月 ${now.getDate()} 日 · 星期${week}`;
		}
		if (daysEl) {
			const start = new Date(`${siteStartDate}T00:00:00+08:00`);
			const now = new Date();
			const days = Math.max(
				1,
				Math.floor(
					(now.getTime() - start.getTime()) / (1000 * 60 * 60 * 24),
				) + 1,
			);
			daysEl.textContent = String(days);
		}
	</script>
</MainGridLayout>
