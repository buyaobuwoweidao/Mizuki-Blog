---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<MainGridLayout title="站长入口" description="仅站长可进入">
	<div class="mx-auto w-full max-w-md px-4 py-16">
		<div
			class="card-base rounded-(--radius-large) overflow-hidden"
		>
			<div class="px-8 py-8 text-center">
				<!-- 锁图标 -->
				<div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full text-2xl"
					style="background: oklch(0.92 0.04 var(--hue)); color: oklch(0.4 0.12 var(--hue));">
					<Icon name="material-symbols:lock-rounded" class="size-7" />
				</div>

				<h2 class="mb-2 text-lg font-bold">站长入口 (｡•̀ᴗ-)✧</h2>
				<p class="mb-6 text-sm text-neutral-500 dark:text-neutral-400">
					这里是博客管理员的专属通道～<br />
					输入暗号才能进入编辑器哦
				</p>

				<!-- 密码输入 -->
				<form id="gate-form" class="space-y-3">
					<input
						id="gate-password"
						type="password"
						placeholder="请输入访问密码"
						autocomplete="off"
						class="w-full rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 px-4 py-2.5 text-center outline-none focus:ring-2"
						style="--tw-ring-color: oklch(0.7 0.14 var(--hue));"
					/>
					<button
						type="submit"
						class="w-full rounded-lg px-4 py-2.5 font-bold text-white transition active:scale-95"
						style="background: oklch(0.62 0.16 var(--hue));"
					>
						进入小窝后台
					</button>
				</form>

				<p id="gate-error" class="mt-4 hidden text-sm" style="color: oklch(0.55 0.2 25);">
					(´；ω；`) 密码不对哦，再想想～
				</p>

				<p class="mt-6 text-xs text-neutral-400 dark:text-neutral-500">
					提示：不是站长就别试啦 (´▽`ʃ♡ƪ)
				</p>
			</div>
		</div>
	</div>

	<script is:inline define:vars={{ baseUrl }}>
		// ===== 站长密码（想修改请改这里）=====
		const STATION_MASTER_PASSWORD = "firefly0801";

		const form = document.getElementById("gate-form");
		const input = document.getElementById("gate-password");
		const error = document.getElementById("gate-error");

		form.addEventListener("submit", (e) => {
			e.preventDefault();
			const value = (input.value || "").trim();
			if (value === STATION_MASTER_PASSWORD) {
				// 密码正确，进入编辑器
				window.location.href = baseUrl + "/admin/";
			} else {
				error.classList.remove("hidden");
				input.value = "";
				input.focus();
			}
		});
	</script>
</MainGridLayout>
