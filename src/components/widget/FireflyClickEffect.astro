---
// 点击萤火虫特效
// 鼠标点到哪，哪就飘起流萤小光点 ✨
// 纯 DOM + CSS 动画，不依赖任何库
---

<div class="firefly-click-layer" aria-hidden="true"></div>

<style is:inline>
	.firefly-click-layer {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 9999;
		overflow: hidden;
	}

	.firefly-particle {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
		background: radial-gradient(
			circle,
			rgba(255, 255, 255, 1) 0%,
			rgba(214, 255, 63, 0.9) 35%,
			rgba(198, 238, 90, 0.35) 60%,
			rgba(198, 238, 90, 0) 75%
		);
		box-shadow:
			0 0 8px 2px rgba(198, 238, 90, 0.55),
			0 0 20px 6px rgba(214, 255, 63, 0.2);
		animation: firefly-rise 0.9s ease-out forwards;
		will-change: transform, opacity;
	}

	@keyframes firefly-rise {
		0% {
			transform: translate(0, 0) scale(1);
			opacity: 1;
		}
		100% {
			transform: translate(var(--dx, 0px), calc(var(--rise, -80px))) scale(0.25);
			opacity: 0;
		}
	}
</style>

<script is:inline>
	(() => {
		const layer = document.querySelector(".firefly-click-layer");
		if (!layer) return;

		let lastClick = 0;

		function spawn(x, y) {
			const now = Date.now();
			if (now - lastClick < 120) return; // 防连点刷屏
			lastClick = now;

			const count = 2 + Math.floor(Math.random() * 2); // 每次 2~3 个
			for (let i = 0; i < count; i++) {
				const p = document.createElement("div");
				p.className = "firefly-particle";

				const size = 6 + Math.random() * 6;
				const dx = (Math.random() - 0.5) * 60;
				const rise = -(50 + Math.random() * 80);
				const jitterX = (Math.random() - 0.5) * 40;

				p.style.width = `${size}px`;
				p.style.height = `${size}px`;
				p.style.left = `${x + (Math.random() - 0.5) * 16}px`;
				p.style.top = `${y + (Math.random() - 0.5) * 16}px`;
				p.style.setProperty("--dx", `${dx + jitterX}px`);
				p.style.setProperty("--rise", `${rise}px`);
				// 错峰一点，别同时灭
				p.style.animationDelay = `${(Math.random() * 0.12).toFixed(2)}s`;

				layer.appendChild(p);
				setTimeout(() => p.remove(), 1200);
			}
		}

		document.addEventListener("click", (e) => {
			spawn(e.clientX, e.clientY);
		});

		// 移动端点按也能触发
		document.addEventListener(
			"touchstart",
			(e) => {
				const t = e.touches[0];
				if (t) spawn(t.clientX, t.clientY);
			},
			{ passive: true },
		);
	})();
</script>
